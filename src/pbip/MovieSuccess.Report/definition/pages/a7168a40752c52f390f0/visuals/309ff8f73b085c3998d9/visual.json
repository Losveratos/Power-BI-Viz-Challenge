            "text": {
              "expr": {
                "Literal": {
                  "Value": "'One dot per film: budget across, revenue up, both on log scales; dot size is the audience rating. Green cleared the 2.5x break-even rule of thumb, red did not. Use the genre and era slicers above to explore a slice.'"
                }
              }
            },
