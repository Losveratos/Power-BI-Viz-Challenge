      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Scatter plot of all 7,733 measurable films. The horizontal axis is production budget and the vertical axis is gross revenue, both on logarithmic scales; dot size encodes the audience rating out of ten. Green dots cleared 2.5 times their budget, red dots did not. The red dots concentrate in the middle budgets, and larger dots \u2014 better rated films \u2014 sit visibly higher at every budget level. The chart responds to the genre and era slicers.'"
                }
              }
            }
          }
        }
      ]
