  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "WHAT IS WRONG WITH THE CHEAP END",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#E66767",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cheap films look extraordinary here, and they are partly an illusion.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#F5F1EC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Films budgeted $10k\u2013100k report revenue only 7.8% of the time. Above $50M, 91.1% do.",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#F5F1EC",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A cheap flop was usually never recorded, so it is missing from this page. An expensive flop is counted. The cheap end is an upper bound on reality, not an expectation.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A8A29B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Only 2.4% of $10k\u2013100k films survive into this analysis, against 90.8% above $50M.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#78716B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Caution panel. Cheap films look extraordinary partly because of survivorship bias: films budgeted between 10,000 and 100,000 dollars report revenue only 7.8% of the time, against 91.1% above 50 million. Cheap flops were never recorded and are missing from this page, while expensive flops are counted, so the cheap end is an upper bound rather than an expectation. Only 2.4% of the cheapest band survives into this analysis, against 90.8% of films above 50 million.'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
