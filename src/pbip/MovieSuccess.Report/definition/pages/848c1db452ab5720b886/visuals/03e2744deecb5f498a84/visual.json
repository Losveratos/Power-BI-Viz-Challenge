  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "CLAIMS THIS REPORT DOES NOT MAKE",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#E66767",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "That making a better film causes a better return.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A8A29B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "That anything here describes the 99.2% of films outside the measurable subset.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A8A29B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "That a 1970s dollar and a 2020s dollar are comparable.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A8A29B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "That 'return' means profit. It is gross revenue over production budget, and nothing more.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A8A29B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "That any of this holds for non-English cinema, which is 15% of even the measurable subset.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A8A29B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "That a genre or studio ranked on fewer than 100 measured films is ranked at all. Those are suppressed, not shown small.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#A8A29B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Panel listing claims this report does not make: that making a better film causes a better return; that anything here describes the 99.2% of films outside the measurable subset; that a 1970s dollar and a 2020s dollar are comparable; that return means profit rather than gross revenue over production budget; that any of this holds for non-English cinema; and that a genre or studio with fewer than 100 measured films is ranked at all.'"
                }
              }
            }
          }
        }
      ]
    }
  }
