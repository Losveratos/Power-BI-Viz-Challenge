table Funnel
	lineageTag: 36f6dbd7-6547-5d09-8e2e-73ef0ce2295c

	column 'Step Order'
		dataType: int64
		formatString: 0
		lineageTag: af47b570-79aa-5999-a27a-4d21b78c39cc
		summarizeBy: none
		sourceColumn: [Step Order]
		isHidden

		annotation SummarizationSetBy = Automatic

	column Step
		dataType: string
		lineageTag: 54e4280b-cb76-599d-9aa6-eba708e16201
		summarizeBy: none
		sourceColumn: [Step]
		sortByColumn: Step Order

